
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated AUT accounts
    function isAutUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@autuni\\.ac\\.nz$');
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if isAutUser()
        && request.auth.uid == userId;
    }

    // Validate new booking information
    function validNewBooking(b) {
      return b.keys().hasOnly([
          'studentId',
          'staffId',
          'staffName',
          'date',
          'time',
          'reason',
          'status',
          'createdAt'
        ])
        && b.keys().hasAll([
          'studentId',
          'staffId',
          'staffName',
          'date',
          'time',
          'status',
          'createdAt'
        ])
        && b.studentId == request.auth.uid
        && b.staffId is string
        && b.staffId.matches('^[A-Za-z0-9_-]{1,80}$')
        && b.staffName is string
        && b.staffName.size() > 0
        && b.staffName.size() <= 120
        && b.date is string
        && b.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && b.time is string
        && b.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && b.get('reason', '') is string
        && b.get('reason', '').size() <= 500
        && b.status == 'pending'
        && b.createdAt == request.time;
    }

    // Check the matching slot when a booking is created
    function matchingSlot(bookingId, b) {
      let slotId = b.staffId + '_' + b.date + '_' + b.time;
      let slot = getAfter(
        /databases/$(database)/documents/bookingSlots/$(slotId)
      ).data;

      return slot.bookingId == bookingId
        && slot.staffId == b.staffId
        && slot.date == b.date
        && slot.time == b.time;
    }

    // Check the matching booking when a slot is created
    function matchingBooking(bookingId, slot) {
      let booking = getAfter(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;

      return booking.studentId == request.auth.uid
        && booking.staffId == slot.staffId
        && booking.date == slot.date
        && booking.time == slot.time
        && booking.status == 'pending';
    }

    // Allow students to cancel their own pending bookings
    function canCancelBooking(bookingId) {
      let booking = resource.data;

      let slotId =
        booking.staffId + '_' + booking.date + '_' + booking.time;

      let slotPath =
        /databases/$(database)/documents/bookingSlots/$(slotId);

      return isAutUser()
        && booking.studentId == request.auth.uid
        && booking.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(booking)
          .affectedKeys().hasOnly(['status'])
        && exists(slotPath)
        && get(slotPath).data.bookingId == bookingId
        && !existsAfter(slotPath);
    }

    // NEW: Allow rescheduling only when both slots are updated
    function canRescheduleBooking(bookingId) {
      let before = resource.data;
      let after = request.resource.data;

      let oldSlotId =
        before.staffId + '_' + before.date + '_' + before.time;

      let newSlotId =
        before.staffId + '_' + after.date + '_' + after.time;

      let oldSlotPath =
        /databases/$(database)/documents/bookingSlots/$(oldSlotId);

      let newSlotPath =
        /databases/$(database)/documents/bookingSlots/$(newSlotId);

      return isAutUser()

        // Only the booking owner may change it
        && before.studentId == request.auth.uid

        // Only pending bookings may be changed
        && before.status == 'pending'
        && after.status == 'pending'

        // Only date and time may change
        && after.diff(before).affectedKeys()
          .hasOnly(['date', 'time'])
        && after.diff(before).affectedKeys()
          .hasAny(['date', 'time'])

        // Validate formats
        && after.date is string
        && after.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && after.time is string
        && after.time.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )

        // The new slot must be different
        && oldSlotId != newSlotId

        // Verify the old slot belongs to the booking
        && exists(oldSlotPath)
        && get(oldSlotPath).data.bookingId == bookingId
        && get(oldSlotPath).data.staffId == before.staffId
        && get(oldSlotPath).data.date == before.date
        && get(oldSlotPath).data.time == before.time

        // The old slot must be deleted
        && !existsAfter(oldSlotPath)

        // The requested new slot must be available
        && !exists(newSlotPath)

        // The new slot must be created in this transaction
        && existsAfter(newSlotPath)
        && getAfter(newSlotPath).data.bookingId == bookingId
        && getAfter(newSlotPath).data.staffId == before.staffId
        && getAfter(newSlotPath).data.date == after.date
        && getAfter(newSlotPath).data.time == after.time;
    }

    // Allow releasing a slot during cancellation
    function canReleaseSlot(slotId) {
      let slot = resource.data;

      let bookingPath =
        /databases/$(database)/documents/bookings/$(slot.bookingId);

      return isAutUser()
        && slotId == (
          slot.staffId + '_' + slot.date + '_' + slot.time
        )
        && exists(bookingPath)
        && get(bookingPath).data.studentId == request.auth.uid
        && get(bookingPath).data.status == 'pending'
        && get(bookingPath).data.staffId == slot.staffId
        && get(bookingPath).data.date == slot.date
        && get(bookingPath).data.time == slot.time
        && getAfter(bookingPath).data.status == 'cancelled'
        && getAfter(bookingPath).data
          .diff(get(bookingPath).data)
          .affectedKeys().hasOnly(['status']);
    }

    // NEW: Allow releasing the old slot during rescheduling
    function canReleaseRescheduledSlot(slotId) {
      let slot = resource.data;

      let bookingPath =
        /databases/$(database)/documents/bookings/$(slot.bookingId);

      let before = get(bookingPath).data;
      let after = getAfter(bookingPath).data;

      let newSlotId =
        after.staffId + '_' + after.date + '_' + after.time;

      let newSlotPath =
        /databases/$(database)/documents/bookingSlots/$(newSlotId);

      return isAutUser()

        // The old slot must be correctly identified
        && slotId == (
          slot.staffId + '_' + slot.date + '_' + slot.time
        )

        // The booking must exist
        && exists(bookingPath)

        // The booking must belong to this user
        && before.studentId == request.auth.uid

        // Verify the old booking and slot match
        && before.staffId == slot.staffId
        && before.date == slot.date
        && before.time == slot.time
        && before.status == 'pending'

        // The booking must still be pending
        && after.status == 'pending'

        // Only the date or time may be changed
        && after.diff(before).affectedKeys()
          .hasOnly(['date', 'time'])
        && after.diff(before).affectedKeys()
          .hasAny(['date', 'time'])

        // Prevent deleting a slot without changing time
        && newSlotId != slotId

        // The new slot must not exist beforehand
        && !exists(newSlotPath)

        // The new slot must exist after the transaction
        && existsAfter(newSlotPath)

        // Verify that the new slot matches the booking
        && getAfter(newSlotPath).data.bookingId == slot.bookingId
        && getAfter(newSlotPath).data.staffId == after.staffId
        && getAfter(newSlotPath).data.date == after.date
        && getAfter(newSlotPath).data.time == after.time;
    }

    // Booking records
    match /bookings/{bookingId} {

      // Students can only read their own bookings
      allow get, list: if isAutUser()
        && resource.data.studentId == request.auth.uid;

      // Creating a booking requires a matching reserved slot
      allow create: if isAutUser()
        && validNewBooking(request.resource.data)
        && matchingSlot(bookingId, request.resource.data);

      // Allow cancellation or valid rescheduling
      allow update: if canCancelBooking(bookingId)
        || canRescheduleBooking(bookingId);

      // Keep booking history
      allow delete: if false;
    }

    // Reserved appointment time slots
    match /bookingSlots/{slotId} {

      // Authenticated AUT users may check individual slots
      allow get: if isAutUser();
      allow list: if false;

      // New slots must match the related booking
      allow create: if isAutUser()
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'staffId',
          'date',
          'time'
        ])
        && request.resource.data.keys().hasAll([
          'bookingId',
          'staffId',
          'date',
          'time'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.staffId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && slotId == (
          request.resource.data.staffId + '_' +
          request.resource.data.date + '_' +
          request.resource.data.time
        )
        && matchingBooking(
          request.resource.data.bookingId,
          request.resource.data
        );

      // Do not allow changing a reserved slot directly
      allow update: if false;

      // Release a slot only during valid cancellation
      // or rescheduling
      allow delete: if canReleaseSlot(slotId)
        || canReleaseRescheduledSlot(slotId);
    }
  }
}
